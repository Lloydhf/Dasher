      </Item>
      <Item class="ModuleScript" referent="DASHER_BUILD_9">
        <Properties>
          <string name="Name">ResetHold</string>
          <ProtectedString name="Source">-- Input-independent hold state. A cancelled or completed physical press must
-- be released before it can start again, including after focus/phase changes.
local ResetHold = {}
ResetHold.Duration = 1.1

function ResetHold.New()
 return {down={},active=nil,startedAt=0,context=nil,triggered=false}
end

function ResetHold.Cancel(state)
 state.active=nil state.context=nil state.startedAt=0 state.triggered=false
end

function ResetHold.Begin(state,token,now,allowed,context)
 if token==nil or state.down[token] then return false end
 state.down[token]=true
 if not allowed or state.active~=nil then return false end
 state.active=token state.startedAt=now state.context=context state.triggered=false
 return true
end

function ResetHold.Release(state,token)
 state.down[token]=nil
 if state.active==token then ResetHold.Cancel(state) end
end

function ResetHold.Step(state,now,allowed,context)
 if state.active==nil then return false,0 end
 if not allowed or state.context~=context or now&lt;state.startedAt then
  ResetHold.Cancel(state) return false,0
 end
 local progress=math.clamp((now-state.startedAt)/ResetHold.Duration,0,1)
 if progress&gt;=1 and not state.triggered then
  state.triggered=true return true,progress
 end
 return false,progress
end

return ResetHold
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="DASHER_BUILD_10">
        <Properties>
          <string name="Name">RoundClock</string>
          <ProtectedString name="Source">-- Absolute server-clock deadlines keep presentation independent of packet arrival.
-- This module is intentionally pure so boundary, delay and acceleration behavior
-- can be exercised outside Studio using exactly the shipped implementation.
local RoundClock = {}

local function finite(value)
	return type(value) == "number" and value == value and math.abs(value) &lt; math.huge
end

function RoundClock.New()
	return {phaseStartedAt = 0, phaseEndsAt = 0, multiplier = 1, clockRevision = 0}
end

function RoundClock.Remaining(state, timestamp)
	if not state or not finite(timestamp) or not finite(state.phaseEndsAt) then return 0 end
	local rate = finite(state.multiplier) and math.max(0, state.multiplier) or 1
	return math.max(0, (state.phaseEndsAt - timestamp) * rate)
end

function RoundClock.Start(clock, timestamp, duration, rate)
	assert(finite(timestamp) and finite(duration) and duration &gt;= 0, "Invalid phase clock")
	rate = rate or 1
	assert(finite(rate) and rate &gt; 0, "Invalid clock rate")
	clock.phaseStartedAt = timestamp
	clock.phaseEndsAt = timestamp + duration / rate
	clock.multiplier = rate
	clock.clockRevision += 1
	return duration
end

function RoundClock.Cap(clock, timestamp, maximum)
	assert(finite(maximum) and maximum &gt;= 0, "Invalid clock cap")
	local remaining = RoundClock.Remaining(clock, timestamp)
	if remaining &gt; maximum then
		remaining = maximum
		clock.phaseEndsAt = timestamp + remaining / clock.multiplier
		clock.clockRevision += 1
	end
	return remaining
end

function RoundClock.SetRate(clock, timestamp, rate)
	assert(finite(rate) and rate &gt; 0, "Invalid clock rate")
	local remaining = RoundClock.Remaining(clock, timestamp)
	if rate ~= clock.multiplier then
		clock.phaseEndsAt = timestamp + remaining / rate
		clock.multiplier = rate
		clock.clockRevision += 1
	end
	return remaining
end

function RoundClock.Countdown(state, timestamp)
	if not state or state.phase ~= "Countdown" then return "" end
	local remaining = RoundClock.Remaining(state, timestamp)
	if remaining &lt;= 0 or remaining &gt; 3 then return "" end
	return tostring(math.ceil(remaining))
end

function RoundClock.Accept(previous, incoming)
	if type(incoming) ~= "table" or not finite(incoming.stateSequence) then return false end
	return not previous or not finite(previous.stateSequence) or incoming.stateSequence &gt; previous.stateSequence
end

return RoundClock
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
