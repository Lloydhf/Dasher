  <Item class="ServerScriptService" referent="DASHER_BUILD_12">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="DASHER_BUILD_13">
      <Properties>
        <string name="Name">CourseMotion</string>
        <ProtectedString name="Source">-- Server-authored anchored terrain. Owners carry their avatars; the server validates matching ride deltas.
local Rules = require(script.Parent:WaitForChild("TowerRules"))
local CourseMotion = {}
CourseMotion.__index = CourseMotion
local CONTACT_HISTORY_SECONDS = 0.5

local function numberValue(model, name, fallback, minimum, maximum)
	local value = model:FindFirstChild(name)
	local number = value and value:IsA("NumberValue") and value.Value or fallback
	if number ~= number or math.abs(number) == math.huge then number = fallback end
	return math.clamp(number, minimum, maximum)
end

function CourseMotion.new(map)
	local self = setmetatable({movers = {}, blinks = {}, spinners = {}, movingParts = {}}, CourseMotion)
	local course = map:FindFirstChild("Course")
	if course then
		for _, model in course:GetChildren() do
			local motion = model:FindFirstChild("Motion")
			if not model:IsA("Model") or not motion or not motion:IsA("StringValue") then continue end
			local period = numberValue(model, "Period", 10, 2, 60)
			local phase = numberValue(model, "Phase", 0, -3600, 3600)
			if motion.Value == "Shuttle" then
				local travel = model:FindFirstChild("Travel")
				if travel and travel:IsA("Vector3Value") and travel.Value.Magnitude &gt; 0 and travel.Value.Magnitude &lt;= 64 then
					local entry = {model = model, origin = model:GetPivot(), travel = travel.Value,
						period = period, dwell = numberValue(model, "Dwell", 1.5, 0, period * 0.45), phase = phase,
						contactParts = {}, contactHistory = {}}
					table.insert(self.movers, entry)
					for _, part in model:GetDescendants() do
						if part:IsA("BasePart") and part.CanCollide then
							self.movingParts[part] = entry
							table.insert(entry.contactParts, {part = part, offset = entry.origin:ToObjectSpace(part.CFrame)})
						end
					end
				end
			elseif motion.Value == "Blink" then
				local entry = {model = model, parts = {}, period = period, phase = phase,
					onDuration = numberValue(model, "OnDuration", 5, 0.25, period - 0.25),
					warningDuration = numberValue(model, "WarningDuration", 1, 0, period)}
				for _, part in model:GetDescendants() do
					if part:IsA("BasePart") then
						table.insert(entry.parts, {part = part, solid = part.CanCollide, color = part.Color,
							transparency = part.Transparency, material = part.Material})
					end
				end
				table.insert(self.blinks, entry)
			end
		end
	end
	local hazards = map:FindFirstChild("Hazards")
	if hazards then
		for _, model in hazards:GetChildren() do
			local motion = model:FindFirstChild("Motion")
			if model:IsA("Model") and motion and motion:IsA("StringValue") and motion.Value == "Spinner" then
				local center, bar = model:FindFirstChild("Center"), model:FindFirstChild("Bar")
				if center and center:IsA("BasePart") and bar and bar:IsA("BasePart") then
					table.insert(self.spinners, {center = center, bar = bar, offset = center.CFrame:ToObjectSpace(bar.CFrame),
						speed = numberValue(model, "AngularSpeed", 0.7, -3, 3), phase = numberValue(model, "Phase", 0, -3600, 3600)})
				end
			end
		end
	end
	return self
end

function CourseMotion:RecentSupport(position, feetDistance, radius, offsets, verticalSpeed, elapsed)
	-- Client-owned character physics and server-owned terrain replicate separately.
	-- Test the exact recent authored surface, never a widened support region or a
	-- client-reported platform. A stationary avatar left behind loses this contact
	-- as soon as the matching pose is older than this short, fixed history window.
	if math.abs(verticalSpeed) &gt;= 12 or verticalSpeed &gt; 2 then return nil end
	for _, mover in self.movers do
		if not mover.model.Parent then continue end
		for _, contact in mover.contactParts do
			local part = contact.part
			if not part.Parent or not part.CanCollide or self.movingParts[part] ~= mover then continue end
			for index = #mover.contactHistory, 1, -1 do
				local frame = mover.contactHistory[index]
				local age = elapsed - frame.at
				if age &lt;= 0 or age &gt; CONTACT_HISTORY_SECONDS then continue end
				local surface = frame.pose * contact.offset
				if (surface.Position - part.Position).Magnitude &lt; 0.01 or surface.UpVector.Y &lt; 0.7 then continue end
				local direction = surface:VectorToObjectSpace(Vector3.new(0, -1, 0))
				if direction.Y &gt;= -0.7 then continue end
				local half = part.Size * 0.5
				for _, offset in offsets do
					local probe = position + offset * radius
					local origin = surface:PointToObjectSpace(probe)
					local distance = (half.Y - origin.Y) / direction.Y
					local point = origin + direction * distance
					if math.abs(point.X) &lt;= half.X and math.abs(point.Z) &lt;= half.Z
						and Rules.GroundContact(distance, feetDistance, surface.UpVector.Y, verticalSpeed) then
						return {Instance = part, Distance = distance, Normal = surface.UpVector,
							Position = probe + Vector3.new(0, -distance, 0), Historical = true}
					end
				end
			end
		end
	end
	return nil
end

function CourseMotion:Step(elapsed)
	local deltas = {}
	for _, entry in self.movers do
		if entry.model.Parent then
			local alpha = Rules.ShuttleAlpha(elapsed + entry.phase, entry.period, entry.dwell)
			local previous = entry.model:GetPivot()
			local target = CFrame.new(entry.travel * alpha) * entry.origin
			entry.model:PivotTo(target)
			deltas[entry] = target * previous:Inverse()
			table.insert(entry.contactHistory, {at = elapsed, pose = target})
			while entry.contactHistory[1] and elapsed - entry.contactHistory[1].at &gt; CONTACT_HISTORY_SECONDS do
				table.remove(entry.contactHistory, 1)
			end
		end
	end
	for _, entry in self.blinks do
		local solid, warning = Rules.BlinkState(elapsed + entry.phase, entry.period, entry.onDuration, entry.warningDuration)
		if solid ~= entry.solid or warning ~= entry.warning then
			entry.solid, entry.warning = solid, warning
			entry.model:SetAttribute("StepActive", solid)
			entry.model:SetAttribute("StepWarning", warning)
			for _, original in entry.parts do
				local part = original.part
				if part.Parent then
					part.CanCollide = solid and original.solid
					part.Transparency = solid and original.transparency or math.max(original.transparency, 0.85)
					part.Color = warning and original.color:Lerp(Color3.fromRGB(255, 185, 72), 0.7) or original.color
					part.Material = warning and Enum.Material.Neon or original.material
				end
			end
		end
	end
	for _, entry in self.spinners do
		if entry.bar.Parent then
			entry.bar.CFrame = entry.center.CFrame * CFrame.Angles(0, elapsed * entry.speed + entry.phase, 0) * entry.offset
		end
	end
	return deltas
end

return CourseMotion
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="DASHER_BUILD_14">
      <Properties>
        <string name="Name">ProfileStore</string>
        <ProtectedString name="Source">-- One record per player, serialized UpdateAsync writes, and an expiring session lock.
-- Studio always uses memory: enabling Studio API access must never alter live progress.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local ProfileStore = {}
ProfileStore.__index = ProfileStore

local SCHEMA = 2
local COURSE_VERSION = 5
local LEGACY_MAPS = {Skyline = true, Neon = true, Grid = true, Foundry = true, Zenith = true, Helix = true, Canopy = true, Reactor = true}
local LOCK_SECONDS = 180
local MAX_COINS = 100000000
local MAX_XP = 100000000
local XP_PER_LEVEL = 500
local DAILY_REWARD = 25
local WEEKLY_TARGET = 10
local WEEKLY_REWARD = 80

local function weekKey(timestamp)
	-- Monday 00:00 UTC; Jan 1 1970 was a Thursday.
	return tostring(math.floor((timestamp + 3 * 86400) / (7 * 86400)))
end

local function finite(value)
	return type(value) == "number" and value == value and math.abs(value) &lt; math.huge
end

local function defaultData(courseVersion)
	return {
		version = SCHEMA, courseVersion = courseVersion or COURSE_VERSION,
		coins = 0, owned = {ice = true}, equipped = "ice", best = {}, legacyBest = {},
		xp = 0, dailyDay = -1,
		weekly = {key = weekKey(os.time()), finishes = 0, score = 0, claimed = false},
	}
end

function ProfileStore.new(config)
	local self = setmetatable({}, ProfileStore)
	self.records = {}
	self.cosmetics = {}
	self.mapIds = {}
	self.sessionId = (game.JobId ~= "" and game.JobId or "studio") .. ":" .. HttpService:GenerateGUID(false)
	self.sessionOnly = RunService:IsStudio() or game.GameId == 0
	self.closing = false
	self.courseVersion = config.CourseVersion or COURSE_VERSION
	self.xpPerLevel = config.XPPerLevel or XP_PER_LEVEL
	self.xpPerFinish = config.XPPerFinish or 100
	self.xpWinBonus = config.XPWinBonus or 50
	self.dailyReward = config.DailyReward or DAILY_REWARD
	self.weeklyTarget = config.WeeklyFinishTarget or WEEKLY_TARGET
	self.weeklyReward = config.WeeklyReward or WEEKLY_REWARD
	self.stageReward = config.StageReward or 3
	self.stageXP = config.StageXP or 25
	self.stageRound = nil
	self.stageClaims = {} -- UserId keys survive disconnect/rejoin within this server round.
	for _, cosmetic in config.Cosmetics do
		self.cosmetics[cosmetic.id] = cosmetic
	end
	for _, id in config.MapOrder do
		self.mapIds[id] = true
	end
	if not self.sessionOnly then
		local ok, store = pcall(function()
			return DataStoreService:GetDataStore("DasherProfiles_v1")
		end)
		if ok then
			self.store = store
		else
			warn("[Dasher] Persistent storage unavailable; existing data will not be overwritten.")
		end
	end
	return self
end

function ProfileStore:_sanitize(raw)
	local data = defaultData(self.courseVersion)
	if type(raw) ~= "table" then
		return data
	end
	if finite(raw.coins) then
		data.coins = math.clamp(math.floor(raw.coins), 0, MAX_COINS)
	end
	if type(raw.owned) == "table" then
		for id in self.cosmetics do
			if raw.owned[id] == true then
				data.owned[id] = true
			end
		end
	end
	if type(raw.equipped) == "string" and data.owned[raw.equipped] then
		data.equipped = raw.equipped
	end
	local oldCourses = raw.courseVersion ~= self.courseVersion
	-- Preserve the retired horizontal courses as history when changing map IDs.
	-- A fixed allowlist keeps arbitrary saved keys out of the profile.
	for id in LEGACY_MAPS do
		local time = type(raw.best) == "table" and raw.best[id]
		if oldCourses and finite(time) and time &gt; 0 and time &lt; 3600 then
			data.legacyBest[id] = time
		end
		local legacy = type(raw.legacyBest) == "table" and raw.legacyBest[id]
		if finite(legacy) and legacy &gt; 0 and legacy &lt; 3600 then
			data.legacyBest[id] = legacy
		end
	end
	if type(raw.best) == "table" then
		for id in self.mapIds do
			local time = raw.best[id]
			if finite(time) and time &gt; 0 and time &lt; 3600 then
				if oldCourses then
					data.legacyBest[id] = time
				else
					data.best[id] = time
				end
			end
		end
	end
	if type(raw.legacyBest) == "table" then
		for id in self.mapIds do
			local time = raw.legacyBest[id]
			if finite(time) and time &gt; 0 and time &lt; 3600 then
				data.legacyBest[id] = time
			end
		end
	end
	if finite(raw.xp) then
		data.xp = math.clamp(math.floor(raw.xp), 0, MAX_XP)
	end
	if finite(raw.dailyDay) then
		data.dailyDay = math.clamp(math.floor(raw.dailyDay), -1, math.floor(os.time() / 86400))
	end
	if type(raw.weekly) == "table" and raw.weekly.key == data.weekly.key then
		for _, field in {"finishes", "score"} do
			if finite(raw.weekly[field]) then
				data.weekly[field] = math.clamp(math.floor(raw.weekly[field]), 0, MAX_XP)
			end
		end
		data.weekly.claimed = raw.weekly.claimed == true
	end
	return data
end

function ProfileStore:Load(player)
	local record = {
		data = defaultData(self.courseVersion), status = "loading", writable = false,
		busy = true, ready = false, closing = false, revision = 0,
		lockId = self.sessionId .. ":" .. HttpService:GenerateGUID(false),
	}
	self.records[player] = record
	if self.sessionOnly or not self.store then
		record.status = self.sessionOnly and "session" or "error"
		record.busy = false
		record.ready = true
		return record.data, record.status
	end
	local key = "player_" .. tostring(player.UserId)
	for attempt = 1, 3 do
		local conflict = false
		local unsupported = false
		local ok, result = pcall(function()
			return self.store:UpdateAsync(key, function(old)
				-- An unknown schema is left untouched rather than replaced by defaults.
				if old ~= nil and (type(old) ~= "table" or (old.version ~= 1 and old.version ~= SCHEMA)) then
					unsupported = true
					return nil
				end
				local lock = old and old.session
				if type(lock) == "table" and lock.id ~= record.lockId
					and finite(lock.updatedAt) and os.time() - lock.updatedAt &lt; LOCK_SECONDS then
					conflict = true
					return nil
				end
				local data = self:_sanitize(old)
				data.session = {id = record.lockId, updatedAt = os.time()}
				return data
			end)
		end)
		if ok and result and result.session and result.session.id == record.lockId then
			record.data = self:_sanitize(result)
			record.status = "saved"
			record.writable = true
			break
		end
		if unsupported then
			warn("[Dasher] Unsupported profile schema for " .. player.UserId .. "; leaving saved data untouched.")
			break
		end
		if attempt &lt; 3 and not self.closing then
			task.wait((conflict and 2 or 0.6) * attempt + math.random() * 0.3)
		end
	end
	if not record.writable then
		record.status = "error"
		warn("[Dasher] Profile load failed/locked for " .. player.UserId .. "; session data cannot overwrite storage.")
	end
	-- Never swap these defaults into persistent storage after a failed read.
	record.ready = true
	record.busy = false
	return record.data, record.status
end

function ProfileStore:Get(player)
	local record = self.records[player]
	return record and record.data or nil
end

function ProfileStore:IsReady(player)
	local record = self.records[player]
	return record ~= nil and record.ready and not record.closing
end

function ProfileStore:GetStatus(player)
	local record = self.records[player]
	return record and record.status or "loading"
end

function ProfileStore:AddCoins(player, amount)
	local record = self.records[player]
	if not self:IsReady(player) or not finite(amount) or amount &lt; 0 then
		return false
	end
	record.data.coins = math.clamp(record.data.coins + math.floor(amount), 0, MAX_COINS)
	record.revision += 1
	return true
end

function ProfileStore:Buy(player, id)
	local record = self.records[player]
	local item = self.cosmetics[id]
	if not self:IsReady(player) or not item then
		return false, "That trail is unavailable."
	end
	if record.data.owned[id] then
		return false, "You already own this trail."
	end
	if record.data.coins &lt; item.price then
		return false, "Not enough coins yet. Finish a race to earn more."
	end
	-- No yields between debit and grant: this is one in-memory transaction.
	record.data.coins -= item.price
	record.data.owned[id] = true
	record.data.equipped = id
	record.revision += 1
	return true, item.name .. " unlocked."
end

function ProfileStore:Equip(player, id)
	local record = self.records[player]
	if not self:IsReady(player) or not self.cosmetics[id] or not record.data.owned[id] then
		return false, "Unlock this trail before equipping it."
	end
	record.data.equipped = id
	record.revision += 1
	return true, self.cosmetics[id].name .. " equipped."
end

function ProfileStore:SetBest(player, mapId, seconds)
	local record = self.records[player]
	if not self:IsReady(player) or not self.mapIds[mapId] or not finite(seconds) or seconds &lt;= 0 then
		return false
	end
	local previous = record.data.best[mapId]
	if not previous or seconds &lt; previous then
		record.data.best[mapId] = seconds
		record.revision += 1
		return true
	end
	return false
end

function ProfileStore:_currentWeek(record)
	local key = weekKey(os.time())
	if record.data.weekly.key ~= key then
		record.data.weekly = {key = key, finishes = 0, score = 0, claimed = false}
		record.revision += 1
	end
	return record.data.weekly
end

function ProfileStore:GetProgression(player)
	local record = self.records[player]
	if not record or not record.ready then
		return nil
	end
	local weekly = self:_currentWeek(record)
	local xp = record.data.xp
	local perLevel = self.xpPerLevel
	return {
		xp = xp, level = 1 + math.floor(xp / perLevel), xpIntoLevel = xp % perLevel,
		xpPerLevel = perLevel, xpToNext = perLevel - xp % perLevel,
		dailyAvailable = record.data.dailyDay &lt; math.floor(os.time() / 86400), dailyReward = self.dailyReward,
		weeklyProgress = weekly.finishes, weeklyTarget = self.weeklyTarget, weeklyClaimed = weekly.claimed,
		weeklyReward = self.weeklyReward, weeklyKey = weekly.key, weeklyScore = weekly.score,
	}
end

function ProfileStore:RecordFinish(player, rank)
	local record = self.records[player]
	if not self:IsReady(player) then
		return 0
	end
	local gained = self.xpPerFinish + (rank == 1 and self.xpWinBonus or 0)
	local weekly = self:_currentWeek(record)
	weekly.finishes = math.min(MAX_XP, weekly.finishes + 1)
	weekly.score = math.min(MAX_XP, weekly.score + gained)
	record.data.xp = math.min(MAX_XP, record.data.xp + gained)
	record.revision += 1
	return gained
end

function ProfileStore:BeginStageRound(roundToken)
	if not finite(roundToken) or roundToken &lt; 1 or roundToken % 1 ~= 0
		or (self.stageRound ~= nil and roundToken &lt;= self.stageRound) then
		return false
	end
	self.stageRound, self.stageClaims = roundToken, {}
	return true
end

function ProfileStore:GetStageProgress(player, roundToken)
	return roundToken == self.stageRound and (self.stageClaims[player.UserId] or 0) or 0
end

function ProfileStore:RecordStage(player, roundToken, stage, totalStages)
	if not self:IsReady(player) or roundToken ~= self.stageRound
		or not finite(stage) or stage % 1 ~= 0 or not finite(totalStages)
		or totalStages % 1 ~= 0 or totalStages &lt; 1 or totalStages &gt; 100
		or stage &lt; 1 or stage &gt; totalStages or stage ~= (self.stageClaims[player.UserId] or 0) + 1 then
		return false, 0, 0
	end
	local record = self.records[player]
	-- Claim, coin credit and XP credit form one yield-free server transaction.
	-- This ledger is separate from attempt gates, so restarts cannot farm rewards.
	self.stageClaims[player.UserId] = stage
	record.data.coins = math.clamp(record.data.coins + self.stageReward, 0, MAX_COINS)
	record.data.xp = math.clamp(record.data.xp + self.stageXP, 0, MAX_XP)
	record.revision += 1
	return true, self.stageReward, self.stageXP
end

function ProfileStore:ClaimDaily(player)
	local record = self.records[player]
	if not self:IsReady(player) then
		return false, "Progress is still loading."
	end
	local day = math.floor(os.time() / 86400)
	if record.data.dailyDay &gt;= day then
		return false, "Today's reward has already been claimed."
	end
	-- Mark and credit without a yield so simultaneous requests cannot double claim.
	record.data.dailyDay = day
	self:AddCoins(player, self.dailyReward)
	return true, "+" .. self.dailyReward .. " coins. Come back tomorrow UTC!"
end

function ProfileStore:ClaimWeekly(player)
	local record = self.records[player]
	if not self:IsReady(player) then
		return false, "Progress is still loading."
	end
	local weekly = self:_currentWeek(record)
	if weekly.claimed then
		return false, "This week's reward has already been claimed."
	end
	if weekly.finishes &lt; self.weeklyTarget then
		return false, "Finish " .. self.weeklyTarget .. " races this week to claim this reward."
	end
	weekly.claimed = true
	self:AddCoins(player, self.weeklyReward)
	return true, "+" .. self.weeklyReward .. " coins. Weekly challenge complete!"
end

function ProfileStore:Save(player, release)
	local record = self.records[player]
	if not record or not record.ready or not record.writable or record.busy then
		return false
	end
	record.busy = true
	local snapshot = self:_sanitize(record.data)
	local key = "player_" .. tostring(player.UserId)
	local succeeded = false
	local lostLock = false
	for attempt = 1, 3 do
		local wrote = false
		local ok = pcall(function()
			self.store:UpdateAsync(key, function(old)
				if type(old) ~= "table" or old.version ~= SCHEMA
					or type(old.session) ~= "table" or old.session.id ~= record.lockId then
					lostLock = true
					return nil
				end
				local output = self:_sanitize(snapshot)
				if not release then
					output.session = {id = record.lockId, updatedAt = os.time()}
				end
				wrote = true
				return output
			end)
		end)
		if ok and wrote and not lostLock then
			succeeded = true
			break
		end
		if lostLock then
			record.writable = false
			break
		end
		if attempt &lt; 3 then
			task.wait(0.5 * attempt + math.random() * 0.2)
		end
	end
	record.status = succeeded and "saved" or "error"
	if succeeded and release then
		record.writable = false
	end
	record.busy = false
	if succeeded and self.OnSaved then
		-- Consumers get the exact committed weekly total, never a newer unsaved value.
		self.OnSaved(player, table.clone(snapshot.weekly))
	end
	if not succeeded then
		warn("[Dasher] Could not save " .. player.UserId .. (lostLock and " (session ownership changed)." or ". Will retry on the next save."))
	end
	return succeeded
end

function ProfileStore:Release(player)
	local record = self.records[player]
	if not record or record.releasing then
		return
	end
	record.releasing = true
	record.closing = true
	local deadline = os.clock() + 23
	while record.busy and os.clock() &lt; deadline do
		task.wait(0.05)
	end
	if not record.busy then
		self:Save(player, true)
		self.records[player] = nil
	else
		-- A load may complete after disconnect; still release its lock when it settles.
		task.spawn(function()
			while record.busy do
				task.wait(0.1)
			end
			self:Save(player, true)
			self.records[player] = nil
		end)
	end
end

function ProfileStore:Close()
	self.closing = true
	for player in self.records do
		task.spawn(function()
			self:Release(player)
		end)
	end
	local deadline = os.clock() + 27
	while next(self.records) ~= nil and os.clock() &lt; deadline do
		task.wait(0.05)
	end
end

return ProfileStore
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="DASHER_BUILD_15">
      <Properties>
        <string name="Name">RoundRules</string>
        <ProtectedString name="Source">-- Pure round-selection helpers. All selection and tallying happen on the server.
local RoundRules = {}

function RoundRules.ChooseOptions(mapOrder, previousMap, random)
	local pool = {}
	for _, id in mapOrder do
		if id ~= previousMap then
			table.insert(pool, id)
		end
	end
	if #pool &lt; 3 and previousMap then
		table.insert(pool, previousMap)
	end
	for index = #pool, 2, -1 do
		local other = random:NextInteger(1, index)
		pool[index], pool[other] = pool[other], pool[index]
	end
	while #pool &gt; 3 do
		table.remove(pool)
	end
	return pool
end

function RoundRules.Tally(options, votes)
	local counts = {}
	for _, id in options do
		counts[id] = 0
	end
	for _, id in votes do
		if counts[id] ~= nil then
			counts[id] += 1
		end
	end
	return counts
end

function RoundRules.Resolve(options, votes, random)
	local counts = RoundRules.Tally(options, votes)
	local tied, highest = {}, -1
	for _, id in options do
		if counts[id] &gt; highest then
			tied, highest = {id}, counts[id]
		elseif counts[id] == highest then
			table.insert(tied, id)
		end
	end
	return #tied &gt; 0 and tied[random:NextInteger(1, #tied)] or nil
end

function RoundRules.SelectEntrants(players, lastPlayed, capacity)
	local ordered = table.clone(players)
	table.sort(ordered, function(a, b)
		local lastA, lastB = lastPlayed[a.UserId] or -1, lastPlayed[b.UserId] or -1
		return lastA &lt; lastB or (lastA == lastB and a.UserId &lt; b.UserId)
	end)
	while #ordered &gt; capacity do table.remove(ordered) end
	return ordered
end

function RoundRules.RaceStatus(roster, connected, remaining, elapsed)
	local entrants, unfinished = 0, 0
	for player, record in roster do
		if connected(player) then
			entrants += 1
			if not record.finished and not record.forfeited then unfinished += 1 end
		end
	end
	if remaining &lt;= 0 then return true, "TimeUp", entrants, unfinished end
	if elapsed &gt;= 2 and unfinished == 0 then
		return true, entrants &gt; 0 and "AllFinished" or "NoRacers", entrants, unfinished
	end
	return false, nil, entrants, unfinished
end

return RoundRules
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="DASHER_BUILD_16">
      <Properties>
        <string name="Name">TowerRules</string>
        <ProtectedString name="Source">-- Scalar tower rules are independent of Roblox services and deterministic in tests.
local TowerRules = {}

function TowerRules.Altitude(y, baseY, finishY, previousPeak)
	local height = math.max(1, finishY - baseY)
	local current = math.clamp(y - baseY, 0, height)
	return current, math.max(previousPeak or 0, current), height, current / height
end

function TowerRules.UpdraftReady(timestamp, lastUse, airborneUsed, groundedSince, cooldown, groundTime)
	if timestamp - lastUse &lt; cooldown then
		return false
	end
	return not airborneUsed or (groundedSince ~= nil and timestamp - groundedSince &gt;= groundTime)
end

function TowerRules.ReachedStage(current, completed, total)
	-- CompletedStage is authored by the server, never supplied by a remote.
	-- A legitimate branch can bypass a particular rest without losing progress.
	if type(completed) ~= "number" or completed ~= completed or completed % 1 ~= 0
		or completed &lt; 0 or completed &gt; total then
		return current
	end
	return math.max(current, completed)
end

function TowerRules.CanFinish(phase, record, profileReady, elapsed, minimumTime)
	return phase == "Racing" and record ~= nil and not record.finished and not record.forfeited
		and profileReady and record.runStartedAt &gt; 0 and elapsed &gt;= minimumTime
end

function TowerRules.GroundContact(distance, feetDistance, normalY, verticalSpeed)
	-- A nearby wall, a surface above the feet, or an airborne crossing is not
	-- support. All inputs come from server raycasts and observed root physics.
	return math.abs(verticalSpeed) &lt; 12 and normalY &gt;= 0.7
		and distance &gt;= feetDistance - 0.55 and distance &lt;= feetDistance + 0.55
end

function TowerRules.FinishContact(localX, localY, localZ, sizeX, sizeY, sizeZ, supported)
	-- The root centre must enter the marked pad's exact prism while its feet
	-- actually rest on that pad. No swept path, avatar padding or contact below.
	return supported and math.abs(localX) &lt;= sizeX * 0.5
		and math.abs(localY) &lt;= sizeY * 0.5 and math.abs(localZ) &lt;= sizeZ * 0.5
end

function TowerRules.ShuttleAlpha(elapsed, period, dwell)
	period = math.max(1, period)
	dwell = math.clamp(dwell, 0, period * 0.45)
	local travel = (period - 2 * dwell) * 0.5
	local t = elapsed % period
	local function ease(value) return value * value * (3 - 2 * value) end
	if t &lt; dwell then return 0 end
	if t &lt; dwell + travel then return ease((t - dwell) / travel) end
	if t &lt; 2 * dwell + travel then return 1 end
	return 1 - ease((t - 2 * dwell - travel) / travel)
end

function TowerRules.BlinkState(elapsed, period, onDuration, warningDuration)
	period = math.max(1, period)
	onDuration = math.clamp(onDuration, 0.25, period - 0.25)
	warningDuration = math.clamp(warningDuration, 0, onDuration)
	local t = elapsed % period
	local solid = t &lt; onDuration
	return solid, solid and t &gt;= onDuration - warningDuration
end

return TowerRules
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="DASHER_BUILD_17">
      <Properties>
        <string name="Name">WeeklyLeaderboard</string>
        <ProtectedString name="Source">-- Ordered weekly scores are published only after the profile carrying them saves.
-- Studio uses memory exclusively, including when Studio API access is enabled.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local WeeklyLeaderboard = {}
WeeklyLeaderboard.__index = WeeklyLeaderboard

local function currentWeek()
	return tostring(math.floor((os.time() + 3 * 86400) / (7 * 86400)))
end

function WeeklyLeaderboard.new()
	return setmetatable({
		sessionOnly = RunService:IsStudio() or game.GameId == 0,
		weekKey = currentWeek(), pending = {}, memory = {}, entries = {}, names = {},
		status = "loading", lastRefresh = -math.huge, flushing = false, refreshing = false,
	}, WeeklyLeaderboard)
end

function WeeklyLeaderboard:_rollWeek()
	local key = currentWeek()
	if self.weekKey ~= key then
		self.weekKey = key
		self.entries, self.memory = {}, {}
		self.lastRefresh = -math.huge
		self.status = "loading"
	end
	return key
end

function WeeklyLeaderboard:Queue(player, weekly)
	if type(weekly) ~= "table" or type(weekly.key) ~= "string" or type(weekly.score) ~= "number"
		or weekly.score ~= weekly.score or weekly.score &lt;= 0 or weekly.score &gt; 100000000 then
		return
	end
	self:_rollWeek()
	local id = tostring(player.UserId)
	self.names[id] = player.Name
	if self.sessionOnly then
		if weekly.key == self.weekKey then
			self.memory[id] = math.max(self.memory[id] or 0, math.floor(weekly.score))
			self:_sessionEntries()
		end
		return
	end
	local key = weekly.key .. ":" .. id
	local existing = self.pending[key]
	self.pending[key] = {
		week = weekly.key, id = id,
		score = math.max(existing and existing.score or 0, math.floor(weekly.score)),
	}
end

function WeeklyLeaderboard:_sessionEntries()
	local entries = {}
	for id, score in self.memory do
		table.insert(entries, {userId = tonumber(id), name = self.names[id] or "Player", score = score})
	end
	table.sort(entries, function(a, b)
		return a.score &gt; b.score or (a.score == b.score and a.userId &lt; b.userId)
	end)
	while #entries &gt; 10 do
		table.remove(entries)
	end
	self.entries, self.status = entries, "ready"
end

function WeeklyLeaderboard:Flush()
	if self.sessionOnly or self.flushing then
		return
	end
	self.flushing = true
	for key, entry in table.clone(self.pending) do
		local ok = pcall(function()
			local store = DataStoreService:GetOrderedDataStore("DasherWeekly_v2", entry.week)
			store:UpdateAsync(entry.id, function(old)
				return math.max(type(old) == "number" and old or 0, entry.score)
			end)
		end)
		if ok and self.pending[key] == entry then
			self.pending[key] = nil
		end
	end
	self.flushing = false
end

function WeeklyLeaderboard:Refresh()
	local key = self:_rollWeek()
	if self.sessionOnly then
		self:_sessionEntries()
		return
	end
	if self.refreshing or os.clock() - self.lastRefresh &lt; 60 then
		return
	end
	self.refreshing = true
	self.lastRefresh = os.clock()
	local ok, entries = pcall(function()
		local store = DataStoreService:GetOrderedDataStore("DasherWeekly_v2", key)
		local page = store:GetSortedAsync(false, 10, 1):GetCurrentPage()
		local result = {}
		for _, row in page do
			local id = tonumber(row.key)
			if id then
				local name = self.names[row.key]
				if not name then
					local named, resolved = pcall(Players.GetNameFromUserIdAsync, Players, id)
					name = named and resolved or ("Player " .. row.key)
					self.names[row.key] = name
				end
				table.insert(result, {userId = id, name = name, score = row.value})
			end
		end
		return result
	end)
	if self.weekKey == key then
		if ok then
			self.entries, self.status = entries, "ready"
		else
			self.status = "unavailable"
		end
	end
	self.refreshing = false
end

function WeeklyLeaderboard:Snapshot()
	self:_rollWeek()
	return {
		scope = self.sessionOnly and "Studio session" or "Global weekly",
		entries = self.entries, weekKey = self.weekKey, status = self.status,
	}
end

function WeeklyLeaderboard:Close()
	-- Profiles:Close runs first so its final durable totals are already queued.
	self:Flush()
end

return WeeklyLeaderboard
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="DASHER_BUILD_18">
      <Properties>
        <string name="Name">DasherServer</string>
        <ProtectedString name="Source">-- Ascent: independent tower climbs, one verified Updraft, moving terrain and stage rewards.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local PhysicsService = game:GetService("PhysicsService")

local shared = ReplicatedStorage:WaitForChild("Dasher")
local Config = require(shared:WaitForChild("Config"))
local RoundClock = require(shared:WaitForChild("RoundClock"))
local ProfileStore = require(script.Parent:WaitForChild("ProfileStore"))
local WeeklyLeaderboard = require(script.Parent:WaitForChild("WeeklyLeaderboard"))
local RoundRules = require(script.Parent:WaitForChild("RoundRules"))
local TowerRules = require(script.Parent:WaitForChild("TowerRules"))
local CourseMotion = require(script.Parent:WaitForChild("CourseMotion"))
local profiles = ProfileStore.new(Config)
local weeklyLeaderboard = WeeklyLeaderboard.new()
profiles.OnSaved = function(player, weekly)
	weeklyLeaderboard:Queue(player, weekly)
end

local remotes = shared:FindFirstChild("Remotes") or Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = shared
local function remote(name)
	local item = remotes:FindFirstChild(name) or Instance.new("RemoteEvent")
	item.Name = name
	item.Parent = remotes
	return item
end
local Action = remote("Action")
local State = remote("State")
local Feedback = remote("Feedback")
local SkillFX = remote("SkillFX")

Players.RespawnTime = 0.45
pcall(function()
	PhysicsService:RegisterCollisionGroup("DasherRacers")
end)
PhysicsService:CollisionGroupSetCollidable("DasherRacers", "DasherRacers", false)

local phase = "Waiting"
local mapId = Config.MapOrder[1]
local roundId = 0
local timeLeft = 0
local multiplier = 1
local phaseClock = RoundClock.New()
local stateSequence = 0
local accelerated = false
local accelerateAt = nil
local accelerationOwner = nil
local finishers = {}
local finishClaims = {}
local lastPlayedRound = {}
local roundEndReason = nil
local finalSprint = false
local roster = {}
local connections = {}
local rateLimits = {}
local activeMap = nil
local startPart = nil
local finishPart = nil
local finishPad = nil
local gates = {}
local courseStages = {}
local hazards = {}
local boundsPart = nil
local courseMotion = nil
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
groundParams.RespectCanCollide = true
local stopping = false
local previousMap = nil
local voteOptions, votes = {}, {}
local spectating = {}
local random = Random.new()
local activeSince = 0
local TEST_MODE = RunService:IsStudio() and workspace:GetAttribute("DasherTestMode") == true
local function testDuration(attribute, fallback)
	local value = workspace:GetAttribute(attribute)
	return TEST_MODE and type(value) == "number" and value &gt; 0 and value &lt; 3600 and value or fallback
end
local timings = {
	intermission = testDuration("TowerQAIntermission", TEST_MODE and 2 or Config.Intermission),
	countdown = testDuration("TowerQACountdown", TEST_MODE and 1 or Config.Countdown),
	round = testDuration("TowerQARoundDuration", TEST_MODE and 12 or Config.RoundDuration),
	results = testDuration("TowerQAResultsDuration", TEST_MODE and 2 or Config.ResultsDuration),
}

local function now()
	return workspace:GetServerTimeNow()
end

local function finite(value)
	return type(value) == "number" and value == value and math.abs(value) &lt; math.huge
end

local function finiteVector(value)
	return typeof(value) == "Vector3" and finite(value.X) and finite(value.Y) and finite(value.Z)
end

local function horizontal(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

local function characterParts(player)
	local character = player.Character
	if not character then
		return nil, nil, nil
	end
	return character, character:FindFirstChild("HumanoidRootPart"), character:FindFirstChildOfClass("Humanoid")
end

local function tell(player, kind, message, extra)
	if player.Parent == Players then
		Feedback:FireClient(player, kind, message, extra)
	end
end

local function announce(message)
	for _, player in Players:GetPlayers() do
		tell(player, "Toast", message)
	end
end

local function rootToFeet(root, humanoid)
	local distance = root.Size.Y * 0.5 + humanoid.HipHeight
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		local leg = humanoid.Parent and humanoid.Parent:FindFirstChild("Left Leg")
		distance += leg and leg:IsA("BasePart") and leg.Size.Y or 2
	end
	return distance
end

local function lobbyCFrame(player)
	local lobby = workspace:FindFirstChild("Lobby")
	local spawn = lobby and lobby:FindFirstChildWhichIsA("SpawnLocation", true)
	local base = spawn and spawn.CFrame + Vector3.new(0, 4, 0) or CFrame.new(0, 28, 85)
	local offset = (math.abs(player.UserId) % 5 - 2) * 2.2
	local _, root, humanoid = characterParts(player)
	local lift = root and humanoid and math.max(0, rootToFeet(root, humanoid) - 4.1) or 0
	return base * CFrame.new(offset, lift, 0)
end

local function startCFrame(player)
	if not startPart then
		return lobbyCFrame(player)
	end
	local slot = roster[player] and roster[player].spawnSlot or (math.abs(player.UserId) % 10 + 1)
	local marker = activeMap and activeMap:FindFirstChild(string.format("Start%02d", slot), true)
	local base = marker and marker:IsA("BasePart") and marker.CFrame
		or startPart.CFrame * CFrame.new(((slot - 1) % 5 - 2) * 4, 0, slot &lt;= 5 and -4 or 4)
	local _, root, humanoid = characterParts(player)
	local lift = root and humanoid and math.max(0, rootToFeet(root, humanoid) - 3.6) or 0
	return base * CFrame.new(0, lift, 0)
end

local function setCharacterMotion(player, frozen)
	local _, root, humanoid = characterParts(player)
	if humanoid then
		humanoid.UseJumpPower = true
		humanoid.WalkSpeed = frozen and 0 or Config.WalkSpeed
		humanoid.JumpPower = frozen and 0 or Config.JumpPower
		humanoid.AutoRotate = not frozen
	end
	if root then
		root.Anchored = frozen
	end
end

local function teleport(player, target, frozen)
	local character, root, humanoid = characterParts(player)
	if not character or not root or not humanoid or humanoid.Health &lt;= 0 then
		return false
	end
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	character:PivotTo(target)
	setCharacterMotion(player, frozen)
	local data = roster[player]
	if data then
		data.lastWorldPosition = target.Position
		data.lastSample = now()
		data.teleportAt = now()
		data.teleportPosition = target.Position
		data.graceUntil = now() + 0.55
		data.airOriginY = target.Position.Y
		data.groundedSince = nil
		data.impulsePendingUntil = nil

	end
	return true
end

local function refreshLeaderstats(player)
	local data = profiles:Get(player)
	local stats = player:FindFirstChild("leaderstats")
	if stats and data then
		stats.Coins.Value = data.coins
	end
end

local function altitudeFor(player, record)
	local height = startPart and finishPart and math.max(1, finishPart.Position.Y - startPart.Position.Y) or 1
	if not record then
		return {current = 0, peak = 0, height = height, stage = 0, totalStages = #gates}, 0
	end
	local current = record.finished and height or (record.currentAltitude or 0)
	return {
		current = current, peak = record.peakAltitude or 0, height = height,
		stage = record.gate, totalStages = #gates,
		rewardedStages = profiles:GetStageProgress(player, roundId),
	}, current / height
end

local function isActive(player, record)
	local _, root, humanoid = characterParts(player)
	return phase == "Racing" and record ~= nil and not record.finished and not record.forfeited
		and root ~= nil and humanoid ~= nil and humanoid.Health &gt; 0
end

local function snapshot(player)
	local timestamp = now()
	stateSequence += 1
	local record = roster[player]
	local data = profiles:Get(player)
	local description = Config.Maps[mapId]
	local altitude, progress = altitudeFor(player, record)
	local counts = RoundRules.Tally(voteOptions, votes)
	local choices, racers = {}, {}
	for _, id in voteOptions do
		table.insert(choices, {id = id, name = Config.Maps[id].name, votes = counts[id]})
	end
	for racer, race in roster do
		if racer.Parent == Players and not race.forfeited then
			table.insert(racers, {
				userId = racer.UserId, name = racer.Name, displayName = racer.DisplayName,
				progress = select(2, altitudeFor(racer, race)), stage = race.gate,
				finished = race.finished,
			})
		end
	end
	table.sort(racers, function(a, b)
		return a.progress &gt; b.progress or (a.progress == b.progress and a.userId &lt; b.userId)
	end)
	return {
		phase = phase,
		mapId = mapId,
		mapName = description and description.name or mapId,
		roundId = roundId,
		roundEndReason = roundEndReason,
		finalSprint = finalSprint,
		raceCapacity = Config.MaxRacers or 10,
		timeLeft = RoundClock.Remaining(phaseClock, timestamp),
		serverNow = timestamp,
		phaseStartedAt = phaseClock.phaseStartedAt,
		phaseEndsAt = phaseClock.phaseEndsAt,
		clockRevision = phaseClock.clockRevision,
		stateSequence = stateSequence,
		multiplier = multiplier,
		finishers = finishers,
		racing = phase == "Racing" and record ~= nil and not record.finished and not record.forfeited,
		finished = record ~= nil and record.finished or false,
		forfeited = record ~= nil and record.forfeited or false,
		spectating = spectating[player] == true,
		racers = racers,
		voteOptions = phase == "Intermission" and choices or {},
		myVote = votes[player],
		canAccelerate = phase == "Racing" and accelerationOwner == player and not accelerated and timeLeft &gt; 12,
		runStartedAt = record and record.runStartedAt or 0,
		coins = data and data.coins or 0,
		owned = data and data.owned or {ice = true},
		equipped = data and data.equipped or "ice",
		progress = progress, altitude = altitude,
		stageRewarded = profiles:GetStageProgress(player, roundId),
		abilities = {
			updraftAt = record and record.lastUpdraft &gt; 0 and record.lastUpdraft or 0,
			updraftArmed = isActive(player, record) and (not record.updraftAirUsed
				or (record.groundedSince ~= nil and now() - record.groundedSince &gt;= Config.UpdraftGroundTime)),
			updraftReadyAt = record and math.max(0, record.lastUpdraft + Config.UpdraftCooldown,
				(record.updraftAirUsed and record.groundedSince) and record.groundedSince + Config.UpdraftGroundTime or 0) or 0,
			updraftReady = isActive(player, record) and TowerRules.UpdraftReady(now(), record.lastUpdraft,
				record.updraftAirUsed, record.groundedSince, Config.UpdraftCooldown, Config.UpdraftGroundTime),
			updraftAirUsed = record and record.updraftAirUsed or false,
		},
		best = data and data.best[mapId] or nil,
		saveStatus = profiles:GetStatus(player),
		progression = profiles:GetProgression(player),
		leaderboard = weeklyLeaderboard:Snapshot(),
	}
end

local function sendState(player)
	if player.Parent == Players then
		local record = roster[player]
		local altitude, progress = altitudeFor(player, record)
		player:SetAttribute("DasherProgress", progress)
		player:SetAttribute("DasherAltitude", altitude.current)
		player:SetAttribute("DasherStage", altitude.stage)
		player:SetAttribute("DasherFinished", record ~= nil and record.finished or false)
		player:SetAttribute("DasherSpectating", spectating[player] == true)
		State:FireClient(player, snapshot(player))
	end
end

local function broadcastState()
	workspace:SetAttribute("DasherPhase", phase)
	workspace:SetAttribute("DasherMapId", mapId)
	workspace:SetAttribute("DasherRoundId", roundId)
	for _, player in Players:GetPlayers() do
		sendState(player)
	end
end

local function addEntrant(player)
	if not profiles:IsReady(player) or roster[player] then
		return
	end
	local connected, occupied = 0, {}
	for entrant, race in roster do
		if entrant.Parent == Players then
			connected += 1
			occupied[race.spawnSlot] = true
		end
	end
	if connected &gt;= (Config.MaxRacers or 10) then return end
	local slot = 1
	while occupied[slot] do slot += 1 end
	local timestamp = now()
	local priorFinish = finishClaims[player.UserId]
	roster[player] = {
		roundId = roundId, gate = priorFinish and #gates or 0, finished = priorFinish ~= nil, forfeited = false,
		spawnSlot = slot,
		finishTime = priorFinish and priorFinish.time or nil,
		runStartedAt = phase == "Racing" and timestamp or 0,
		lastGateAt = timestamp,
		lastReset = -math.huge, resetCount = 0,
		lastSample = timestamp,
		currentAltitude = 0, peakAltitude = 0,
		lastUpdraft = -math.huge, updraftAirUsed = false,
	}
	lastPlayedRound[player.UserId] = roundId
	player:SetAttribute("IsRacing", phase == "Racing" and not priorFinish)
	player:SetAttribute("UpdraftAt", 0)
	teleport(player, priorFinish and lobbyCFrame(player) or startCFrame(player), phase == "Countdown" and not priorFinish)
	sendState(player)
end

local function resetRun(player, reason, reasonCode)
	local record = roster[player]
	if phase ~= "Racing" or not record or record.finished or record.forfeited or now() - record.lastReset &lt; 0.45 then
		return
	end
	record.lastReset = now()
	record.gate = 0
	record.lastGateAt = now()
	record.updraftAirUsed = false
	record.currentAltitude = 0
	record.resetCount += 1
	record.safeSupport = nil
	record.safeOffset = nil
	player:SetAttribute("DasherLastResetReason", reasonCode or "ManualRestart")
	teleport(player, startCFrame(player), false)
	tell(player, "Reset", reason or "Back to the start. You have this.", {reason = reason, reasonCode = reasonCode or "ManualRestart", count = record.resetCount})
	sendState(player)
end

-- Swept boxes preserve gate and hazard detection between physics samples.
local function intersectsBox(part, from, to, padding)
	local a = part.CFrame:PointToObjectSpace(from)
	local b = part.CFrame:PointToObjectSpace(to)
	local direction = b - a
	local extent = part.Size * 0.5 + (typeof(padding) == "Vector3" and padding or Vector3.new(padding, padding, padding))
	local minT, maxT = 0, 1
	for _, axis in {"X", "Y", "Z"} do
		local origin, delta, limit = a[axis], direction[axis], extent[axis]
		if math.abs(delta) &lt; 0.0001 then
			if math.abs(origin) &gt; limit then
				return false
			end
		else
			local entry, leave = (-limit - origin) / delta, (limit - origin) / delta
			if entry &gt; leave then
				entry, leave = leave, entry
			end
			minT = math.max(minT, entry)
			maxT = math.min(maxT, leave)
			if minT &gt; maxT then
				return false
			end
		end
	end
	return true
end

local function creditStages(player, record, completed, quiet)
	local reached = TowerRules.ReachedStage(record.gate, completed, #gates)
	if reached &lt;= record.gate then return end
	record.gate = reached
	record.lastGateAt = now()
	local coins, xp = 0, 0
	-- Claims are stored by UserId outside the attempt record. Filling skipped
	-- milestones is safe across falls, restarts and same-server reconnects.
	for stage = profiles:GetStageProgress(player, roundId) + 1, reached do
		local awarded, stageCoins, stageXP = profiles:RecordStage(player, roundId, stage, #gates)
		if awarded then coins += stageCoins; xp += stageXP end
	end
	if coins &gt; 0 or xp &gt; 0 then
		refreshLeaderstats(player)
		if not quiet then
			tell(player, "StageCompleted", "Sector " .. reached .. " cleared!", {stage = reached, coins = coins, xp = xp})
		end
	end
	sendState(player)
end

local function finishRun(player)
	local record = roster[player]
	if phase ~= "Racing" or not record or record.finished or record.forfeited or finishClaims[player.UserId]
		or not profiles:IsReady(player) or record.runStartedAt &lt;= 0 then
		return
	end
	local elapsed = now() - record.runStartedAt
	local routeLength = (finishPart.Position - startPart.Position).Magnitude
	-- Validated crown contact ends the run. Exact rest history must not reject a
	-- legitimate Updraft shortcut; grounded goal contact is checked by the caller.
	if not TowerRules.CanFinish(phase, record, profiles:IsReady(player), elapsed,
		routeLength / math.max(Config.WalkSpeed, Config.UpdraftSpeed)) then
		-- An early/unready contact cannot award a finish, but it also must not
		-- destroy an otherwise valid attempt. Continue observing the player.
		return
	end
	record.finished = true -- Commit first, before any reward path or remote response.
	record.finishTime = elapsed
	player:SetAttribute("IsRacing", false)
	local rank = #finishers + 1
	local reward = Config.FinishReward + (Config.RankBonuses[rank] or 0)
	local result = {userId = player.UserId, name = player.DisplayName, time = elapsed, coins = reward, rank = rank}
	finishClaims[player.UserId] = result
	table.insert(finishers, result)
	creditStages(player, record, #gates, true)
	profiles:AddCoins(player, reward)
	local xp = profiles:RecordFinish(player, rank)
	if weeklyLeaderboard.sessionOnly then
		weeklyLeaderboard:Queue(player, profiles:Get(player).weekly)
	end
	local personalBest = profiles:SetBest(player, mapId, elapsed)
	if rank == 1 then
		accelerationOwner = player
		finalSprint = true
		timeLeft = RoundClock.Cap(phaseClock, now(), Config.FirstFinishGrace or 90)
		announce(player.DisplayName .. " reached the crown! Final sprint: " .. math.ceil(timeLeft) .. " seconds.")
	end
	refreshLeaderstats(player)
	tell(player, "Finish", personalBest and "New personal best!" or "Run complete!", {
		time = elapsed, rank = rank, coins = reward, xp = xp, personalBest = personalBest,
	})
	teleport(player, lobbyCFrame(player), false)
	broadcastState()
end

local supportOffsets = {
	Vector3.zero, Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0),
	Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
	Vector3.new(0.707, 0, 0.707), Vector3.new(-0.707, 0, 0.707),
	Vector3.new(0.707, 0, -0.707), Vector3.new(-0.707, 0, -0.707),
}

local function groundSupport(root, humanoid, record, timestamp)
	local verticalSpeed = root.AssemblyLinearVelocity.Y
	if math.abs(verticalSpeed) &gt;= 12 then return nil end
	local feetDistance = rootToFeet(root, humanoid)
	local radius = math.min(0.8, math.max(root.Size.X, root.Size.Z) * 0.4)
	for _, offset in supportOffsets do
		local result = workspace:Raycast(root.Position + offset * radius,
			Vector3.new(0, -feetDistance - 0.55, 0), groundParams)
		if result and TowerRules.GroundContact(result.Distance, feetDistance, result.Normal.Y, verticalSpeed) then
			return result
		end
	end
	if courseMotion and record and timestamp and not humanoid.Jump
		and humanoid:GetState() ~= Enum.HumanoidStateType.Jumping
		and (not record.impulsePendingUntil or timestamp &gt;= record.impulsePendingUntil) then
		return courseMotion:RecentSupport(root.Position, feetDistance, radius, supportOffsets,
			verticalSpeed, math.max(0, timestamp - activeSince))
	end
	return nil
end

local function refreshGround(record, root, humanoid, timestamp, result)
	-- Humanoids can stand with part of their footprint beyond a platform edge.
	-- Center-only rays miss that genuine support and incorrectly expire flight.
	local grounded = result ~= nil
	if record.impulsePendingUntil and timestamp &lt; record.impulsePendingUntil then
		-- Do not mistake the approval's network round-trip for a fresh landing.
		if root.AssemblyLinearVelocity.Y &gt; 15 or root.Position.Y &gt; record.airOriginY + 1.5 then
			record.impulsePendingUntil = nil
		elseif grounded then
			return true, result.Instance
		end
	end
	if grounded then
		record.groundedSince = record.groundedSince or timestamp
		if timestamp - record.groundedSince &gt;= Config.UpdraftGroundTime then
			record.updraftAirUsed = false
		end
		record.airOriginY = root.Position.Y
	else
		record.groundedSince = nil
	end
	return grounded, result and result.Instance or nil
end

local function updateCourseMotion(timestamp)
	if courseMotion then courseMotion:Step(math.max(0, timestamp - activeSince)) end
end

local function correctMovement(player, record, reasonCode)
	local support = record.safeSupport
	local target = support and support.Parent and support.CanCollide and record.safeOffset
		and support.CFrame * record.safeOffset or startCFrame(player)
	-- Only invalid (NaN/infinite) physics uses this recovery path. Ordinary
	-- movement never teleports a player or suppresses stage/finish credit.
	teleport(player, target, false)
	record.movementCorrections = (record.movementCorrections or 0) + 1
	player:SetAttribute("DasherMovementCorrections", record.movementCorrections)
	player:SetAttribute("DasherLastMovementReason", reasonCode)
	tell(player, "MovementCorrected", "Connection correction: returned to your last landing.", {reasonCode = reasonCode, count = record.movementCorrections})
	sendState(player)
end

local function validateRacer(player, record, timestamp)
	local _, root, humanoid = characterParts(player)
	if not root or not humanoid or humanoid.Health &lt;= 0 then
		return
	end
	local position = root.Position
	if not finiteVector(position) or not finiteVector(root.AssemblyLinearVelocity) then
		correctMovement(player, record, "NonFinitePosition")
		return
	end
	local boundPosition = boundsPart and boundsPart.CFrame:PointToObjectSpace(position) or position
	local extent = boundsPart and boundsPart.Size * 0.5 or Vector3.new(70, 300, 70)
	if math.abs(boundPosition.X) &gt; extent.X or math.abs(boundPosition.Z) &gt; extent.Z
		or math.abs(boundPosition.Y) &gt; extent.Y then
		resetRun(player, "Back to the base. Find your next landing.", "CourseBounds")
		return
	end
	if record.graceUntil and timestamp &lt; record.graceUntil then
		return
	end
	-- Automatic speed/flight corrections are deliberately removed. Replicated
	-- movement must not invalidate an ordinary jump, ride, fall or landing.
	-- Authoritative skill cooldowns, contact-based progress, finish eligibility,
	-- hazards, bounds and non-finite physics protection remain active.
	local routePrevious = record.lastWorldPosition or position
	local support = groundSupport(root, humanoid, record, timestamp)
	local grounded, groundPart = refreshGround(record, root, humanoid, timestamp, support)
	local current, peak = TowerRules.Altitude(position.Y, startPart.Position.Y, finishPart.Position.Y, record.peakAltitude)
	record.currentAltitude, record.peakAltitude = current, peak
	-- The lower-body volume catches ankle-height killbrick borders as well as
	-- torso-height rotating bars; sampling only root/feet points misses the legs.
	local feet = rootToFeet(root, humanoid)
	local rootHalf = root.Size.Y * 0.5
	local bodyOffset = Vector3.new(0, (feet - rootHalf) * 0.5, 0)
	local bodyRadius = math.min(root.Size.X, root.Size.Z) * 0.45
	local bodyPadding = Vector3.new(bodyRadius, (feet + rootHalf) * 0.5, bodyRadius)
	-- A long replicated jump is an arc, not a straight segment through a beam.
	-- Sweep only short neighbouring samples; large bursts require actual contact.
	local shortSweep = horizontal(position - routePrevious).Magnitude &lt;= 3 and math.abs(position.Y - routePrevious.Y) &lt;= 2
	local hazardFrom = shortSweep and routePrevious or position
	for _, hazard in hazards do
		if hazard.Parent and intersectsBox(hazard, hazardFrom - bodyOffset, position - bodyOffset, bodyPadding) then
			resetRun(player, "Back to the start. Watch the hazards.", "HazardContact")
			return
		end
	end
	-- Only a real landing on an authored course surface grants progress. A
	-- jump apex, scenery contact or arbitrary reported altitude grants nothing.
	-- Branches and intentional Updraft shortcuts can reach a higher milestone
	-- without touching one particular rest in every earlier sector.
	if grounded and courseStages[groundPart] ~= nil then
		creditStages(player, record, courseStages[groundPart], false)
		-- Static verified landings are rollback anchors. Disappearing/moving
		-- surfaces are intentionally excluded from this recovery history.
		local parentMotion = groundPart.Parent and groundPart.Parent:FindFirstChild("Motion")
		if not parentMotion and groundPart.CanCollide then
			record.safeSupport = groundPart
			record.safeOffset = groundPart.CFrame:ToObjectSpace(root.CFrame)
		end
	end
	local finishLocal = finishPart and finishPart.CFrame:PointToObjectSpace(position)
	if finishLocal and TowerRules.FinishContact(
		finishLocal.X, finishLocal.Y, finishLocal.Z, finishPart.Size.X, finishPart.Size.Y, finishPart.Size.Z,
		grounded and groundPart == finishPad) then
		finishRun(player)
		return
	end
	record.lastWorldPosition = position
	record.lastSample = timestamp
end

local function applyLighting(id)
	local theme = Config.Maps[id]
	if not theme then
		return
	end
	Lighting.ClockTime = theme.clockTime
	Lighting.Ambient = theme.ambient
	Lighting.OutdoorAmbient = theme.outdoorAmbient
	Lighting.FogColor = theme.fogColor
	Lighting.FogStart = theme.fogStart
	Lighting.FogEnd = theme.fogEnd
end

local function applyLobbyLighting()
	local theme = Config.Lobby
	if type(theme) ~= "table" then
		return
	end
	for key, property in {
		clockTime = "ClockTime", ambient = "Ambient", outdoorAmbient = "OutdoorAmbient",
		fogColor = "FogColor", fogStart = "FogStart", fogEnd = "FogEnd",
	} do
		if theme[key] ~= nil then
			Lighting[property] = theme[key]
		end
	end
end

local function loadMap(id)
	local templates = ServerStorage:WaitForChild("Maps")
	local template = templates:FindFirstChild(id)
	if not template then
		warn("[Dasher] Missing map " .. id)
		return false
	end
	local clone = template:Clone()
	local mapStart = clone:FindFirstChild("Start")
	local mapFinish = clone:FindFirstChild("Finish")
	local folder = clone:FindFirstChild("Gates")
	local bounds = clone:FindFirstChild("Bounds")
	if not mapStart or not mapStart:IsA("BasePart") or not mapFinish or not mapFinish:IsA("BasePart")
		or not folder or not bounds or not bounds:IsA("BasePart") then
		clone:Destroy()
		warn("[Dasher] Map contract incomplete for " .. id)
		return false
	end
	if activeMap then
		activeMap:Destroy()
	end
	clone.Name = "ActiveMap"
	clone.Parent = workspace
	activeMap, startPart, finishPart = clone, mapStart, mapFinish
	finishPad = clone:FindFirstChild("FinishPad", true)
	boundsPart = bounds
	groundParams.FilterDescendantsInstances = {clone}
	gates = {}
	for _, part in folder:GetChildren() do
		if part:IsA("BasePart") then
			table.insert(gates, part)
		end
	end
	table.sort(gates, function(a, b)
		return a.Name &lt; b.Name
	end)
	courseStages = {}
	for _, part in clone:GetDescendants() do
		if part:IsA("BasePart") then
			local marker = part:FindFirstChild("CompletedStage")
			if marker and marker:IsA("IntValue") and marker.Value &gt;= 0 and marker.Value &lt;= #gates then
				courseStages[part] = marker.Value
			end
		end
	end
	hazards = {}
	local hazardFolder = clone:FindFirstChild("Hazards")
	if hazardFolder then
		for _, item in hazardFolder:GetChildren() do
			if item:IsA("BasePart") then
				table.insert(hazards, item)
			elseif item:IsA("Model") then
				local motion, bar = item:FindFirstChild("Motion"), item:FindFirstChild("Bar")
				if motion and motion:IsA("StringValue") and motion.Value == "Spinner"
					and bar and bar:IsA("BasePart") then
					table.insert(hazards, bar)
				end
			end
		end
	end
	courseMotion = CourseMotion.new(clone)
	mapId = id
	applyLighting(id)
	return true
end

local function handleCharacter(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root or player.Parent ~= Players or player.Character ~= character then
		return
	end
	local function groupPart(part)
		if part:IsA("BasePart") then
			part.CollisionGroup = "DasherRacers"
		end
	end
	for _, item in character:GetDescendants() do
		groupPart(item)
	end
	local descendantConnection = character.DescendantAdded:Connect(groupPart)
	character.Destroying:Once(function()
		descendantConnection:Disconnect()
	end)
	setCharacterMotion(player, false)
	humanoid.Died:Once(function()
		local record = roster[player]
		if record and not record.finished and not record.forfeited then
			record.gate = 0
			record.currentAltitude = 0
			record.updraftAirUsed = false
			record.lastGateAt = now()
		end
	end)
	local record = roster[player]
	if (phase == "Racing" or phase == "Countdown") and record and not record.finished and not record.forfeited then
		record.gate = 0
		record.lastGateAt = now()
		record.safeSupport, record.safeOffset = nil, nil
		teleport(player, startCFrame(player), phase == "Countdown")
		tell(player, "Reset", "Back to the start.")
	else
		teleport(player, lobbyCFrame(player), false)
	end
end

local function playerAdded(player)
	if connections[player] then
		return
	end
	player:SetAttribute("IsRacing", false)
	player:SetAttribute("EquippedTrail", "ice")
	player:SetAttribute("UpdraftAt", 0)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	stats.Parent = player
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Parent = stats
	connections[player] = player.CharacterAdded:Connect(function(character)
		handleCharacter(player, character)
	end)
	if player.Character then
		task.spawn(handleCharacter, player, player.Character)
	end
	task.spawn(function()
		local data, status = profiles:Load(player)
		if player.Parent ~= Players then
			profiles:Release(player)
			return
		end
		player:SetAttribute("EquippedTrail", data.equipped)
		refreshLeaderstats(player)
		if status == "saved" or status == "session" then
			weeklyLeaderboard:Queue(player, data.weekly)
		end
		if status == "error" then
			tell(player, "Error", "Saved progress is unavailable. You can play, but this session will not be saved.")
		end
		if phase == "Racing" or phase == "Countdown" then
			addEntrant(player)
		end
		sendState(player)
	end)
end

local function allowAction(player, action)
	local timestamp = now()
	local limit = rateLimits[player]
	if not limit then
		limit = {tokens = 20, updatedAt = timestamp, actions = {}}
		rateLimits[player] = limit
	end
	limit.tokens = math.min(20, limit.tokens + (timestamp - limit.updatedAt) * 12)
	limit.updatedAt = timestamp
	if limit.tokens &lt; 1 then
		return false
	end
	limit.tokens -= 1
	local interval = 0.25
	if timestamp - (limit.actions[action] or -math.huge) &lt; interval then
		return false
	end
	limit.actions[action] = timestamp
	return true
end

local knownActions = {
	Ready = true, Restart = true, Accelerate = true, Buy = true, Equip = true,
	Vote = true, Spectate = true, ClaimDaily = true, ClaimWeekly = true,
	Updraft = true,
}
Action.OnServerEvent:Connect(function(player, action, payload)
	if type(action) ~= "string" or not knownActions[action] then
		return
	end
	-- Stopping a camera mode must work even immediately after entering it or when
	-- the client discovers there are no valid targets. It grants no eligibility,
	-- and an already stopped state performs no work, so repeated exits are inert.
	if action == "Spectate" and payload == false then
		if spectating[player] then
			spectating[player] = false
			sendState(player)
		end
		return
	end
	if not allowAction(player, action) then
		return
	end
	if action == "Ready" then
		sendState(player)
	elseif action == "Updraft" then
		local record = roster[player]
		local _, root = characterParts(player)
		local timestamp = now()
		if not isActive(player, record) or not finiteVector(root.Position) or not finiteVector(root.AssemblyLinearVelocity)
			or not TowerRules.UpdraftReady(timestamp, record.lastUpdraft,
			record.updraftAirUsed, record.groundedSince, Config.UpdraftCooldown, Config.UpdraftGroundTime) then
			tell(player, "SkillDenied", "Updraft needs a landing and its cooldown.", {skill = "Updraft"})
			return
		end
		record.lastUpdraft = timestamp
		record.updraftAirUsed = true
		record.groundedSince = nil
		record.airOriginY = root.Position.Y
		record.impulsePendingUntil = timestamp + 0.5
		local horizontalSpeed = horizontal(root.AssemblyLinearVelocity)
		if horizontalSpeed.Magnitude &gt; (Config.WalkSpeed * 1.35) then
			horizontalSpeed = horizontalSpeed.Unit * (Config.WalkSpeed * 1.35)
		end
		local velocity = horizontalSpeed + Vector3.new(0, Config.UpdraftSpeed, 0)
		player:SetAttribute("UpdraftAt", timestamp)
		tell(player, "Updraft", "", {at = timestamp, velocity = velocity})
		SkillFX:FireAllClients("Updraft", {userId = player.UserId, position = root.Position, at = timestamp})
		sendState(player)
	elseif action == "Vote" then
		if phase ~= "Intermission" or not profiles:IsReady(player) or type(payload) ~= "string"
			or #payload &gt; 32 or not table.find(voteOptions, payload) then
			return
		end
		votes[player] = payload
		broadcastState()
	elseif action == "Spectate" then
		if type(payload) ~= "boolean" then
			return
		end
		if payload and (phase ~= "Racing" or not profiles:IsReady(player)) then
			return
		end
		local record = roster[player]
		if payload and record and not record.finished and not record.forfeited then
			record.forfeited = true
			record.gate = 0
			player:SetAttribute("IsRacing", false)
			teleport(player, lobbyCFrame(player), false)
			tell(player, "Toast", "Spectating until the next race. This run was forfeited.")
		end
		spectating[player] = payload
		sendState(player)
	elseif action == "ClaimDaily" or action == "ClaimWeekly" then
		local ok, message
		if action == "ClaimDaily" then
			ok, message = profiles:ClaimDaily(player)
		else
			ok, message = profiles:ClaimWeekly(player)
		end
		if ok then
			refreshLeaderstats(player)
			task.spawn(function()
				profiles:Save(player, false)
			end)
		end
		tell(player, ok and "Reward" or "Error", message)
		sendState(player)
	elseif action == "Restart" then
		resetRun(player, "Fresh attempt. The clock keeps running.")
	elseif action == "Accelerate" then
		if phase == "Racing" and accelerationOwner == player and not accelerated and timeLeft &gt; 12 then
			accelerated = true
			accelerateAt = now() + 3
			announce("Clock boost in 3 seconds. Keep moving!")
			broadcastState()
		end
	elseif action == "Buy" or action == "Equip" then
		if type(payload) ~= "string" or #payload &gt; 24 then
			return
		end
		local ok, message
		if action == "Buy" then
			ok, message = profiles:Buy(player, payload)
		else
			ok, message = profiles:Equip(player, payload)
		end
		if ok then
			player:SetAttribute("EquippedTrail", payload)
			refreshLeaderstats(player)
			tell(player, "Purchase", message, {id = payload, coins = profiles:Get(player).coins})
		else
			tell(player, "Error", message)
		end
		sendState(player)
	end
end)

Players.PlayerAdded:Connect(playerAdded)
Players.PlayerRemoving:Connect(function(player)
	roster[player] = nil
	votes[player] = nil
	spectating[player] = nil
	rateLimits[player] = nil
	if connections[player] then
		connections[player]:Disconnect()
		connections[player] = nil
	end
	if accelerationOwner == player and not accelerated then
		accelerationOwner = nil
	end
	task.spawn(function()
		profiles:Release(player)
	end)
end)
for _, player in Players:GetPlayers() do
	playerAdded(player)
end

local stateAccumulator = 0
RunService.Heartbeat:Connect(function(dt)
	stateAccumulator += dt
	if phase == "Racing" then
		local timestamp = now()
		updateCourseMotion(timestamp)
		-- A queued jump can leave a narrow landing in less than 0.08 seconds.
		-- Observe it at the physics cadence using the complete validation path,
		-- rather than granting unverified ground credit or extra airborne time.
		for player, record in roster do
			if player.Parent == Players and not record.finished and not record.forfeited then
				validateRacer(player, record, timestamp)
			end
		end
	end
	if stateAccumulator &gt;= 0.25 then
		stateAccumulator = 0
		broadcastState()
	end
end)

task.spawn(function()
	while not stopping do
		task.wait(45)
		for _, player in Players:GetPlayers() do
			task.spawn(function()
				profiles:Save(player, false)
			end)
		end
	end
end)

task.spawn(function()
	while not stopping do
		weeklyLeaderboard:Flush()
		weeklyLeaderboard:Refresh()
		task.wait(45)
	end
end)

local function beginPhaseClock(duration)
	multiplier = 1
	timeLeft = RoundClock.Start(phaseClock, now(), duration, 1)
end

local function waitPhase(duration, alreadyStarted)
	if not alreadyStarted then beginPhaseClock(duration) end
	broadcastState()
	while timeLeft &gt; 0 and not stopping do
		RunService.Heartbeat:Wait()
		timeLeft = RoundClock.Remaining(phaseClock, now())
		if #Players:GetPlayers() == 0 then
			return false
		end
	end
	return not stopping
end

local function runRounds()
	while not stopping do
		phase = "Waiting"
		beginPhaseClock(0)
		while #Players:GetPlayers() == 0 and not stopping do
			task.wait(0.3)
		end
		if stopping then
			break
		end
		phase = "Intermission"
		applyLobbyLighting()
		multiplier = 1
		accelerated, accelerateAt, accelerationOwner = false, nil, nil
		finishers, roster, spectating, votes = {}, {}, {}, {}
		finishClaims = {}
		roundEndReason, finalSprint = nil, false
		for _, player in Players:GetPlayers() do
			player:SetAttribute("IsRacing", false)
			teleport(player, lobbyCFrame(player), false)
		end
		voteOptions = RoundRules.ChooseOptions(Config.MapOrder, previousMap, random)
		if not waitPhase(timings.intermission) then
			continue
		end
		mapId = RoundRules.Resolve(voteOptions, votes, random) or Config.MapOrder[1]
		if not loadMap(mapId) then
			announce("The course is being prepared. Retrying shortly.")
			task.wait(3)
			continue
		end
		previousMap = mapId
		roundId += 1
		profiles:BeginStageRound(roundId)
		phase = "Countdown"
		-- addEntrant sends an individual snapshot. Publish its real deadline
		-- before enrollment so no client starts the intro with a stale zero.
		beginPhaseClock(timings.countdown)
		for _, player in RoundRules.SelectEntrants(Players:GetPlayers(), lastPlayedRound, Config.MaxRacers or 10) do
			addEntrant(player)
		end
		if not waitPhase(timings.countdown, true) then
			continue
		end
		phase = "Racing"
		activeSince = now()
		timeLeft = RoundClock.Start(phaseClock, activeSince, timings.round, 1)
		for player, record in roster do
			record.runStartedAt = activeSince
			record.lastGateAt = activeSince
			player:SetAttribute("IsRacing", true)
			teleport(player, startCFrame(player), false)
		end
		broadcastState()
		while timeLeft &gt; 0 and not stopping and #Players:GetPlayers() &gt; 0 do
			task.wait(0.05)
			local timestamp = now()
			if accelerateAt and timestamp &gt;= accelerateAt then
				multiplier = Config.SpeedMultiplier
				-- Apply at the announced instant even when a server frame is late.
				RoundClock.SetRate(phaseClock, accelerateAt, multiplier)
				accelerateAt = nil
			end
			timeLeft = RoundClock.Remaining(phaseClock, timestamp)
			local ended, reason = RoundRules.RaceStatus(roster, function(player)
				return player.Parent == Players
			end, timeLeft, timestamp - activeSince)
			if ended then
				roundEndReason = reason
				break
			end
		end
		phase = "Results"
		roundEndReason = roundEndReason or (timeLeft &lt;= 0 and "TimeUp" or "NoRacers")
		spectating = {}
		applyLobbyLighting()
		for _, player in Players:GetPlayers() do
			player:SetAttribute("IsRacing", false)
			teleport(player, lobbyCFrame(player), false)
		end
		waitPhase(timings.results)
	end
end

-- The first lobby visit should already show what players will climb.
-- This uses the same active-map slot; the voted tower replaces it at countdown.
loadMap(Config.MapOrder[1])
applyLobbyLighting()
task.spawn(runRounds)
game:BindToClose(function()
	stopping = true
	profiles:Close()
	weeklyLeaderboard:Close()
end)
</ProtectedString>
        <bool name="Disabled">false</bool>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="DASHER_BUILD_19">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">34</float>
      <float name="CameraMinZoomDistance">7</float>
      <bool name="EnableMouseLockOption">true</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="DASHER_BUILD_20">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="DASHER_BUILD_21">
        <Properties>
          <string name="Name">DasherClient</string>
          <ProtectedString name="Source">-- Dasher Ascent: one movement skill, restrained presentation, authoritative rewards.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local SoundService = game:GetService("SoundService")
local GuiService = game:GetService("GuiService")
local StarterGui = game:GetService("StarterGui")
local player = Players.LocalPlayer
local package = ReplicatedStorage:WaitForChild("Dasher")
local Config = require(package:WaitForChild("Config"))
local RoundClock = require(package:WaitForChild("RoundClock"))
local ResetHold = require(package:WaitForChild("ResetHold"))
local remotes = package:WaitForChild("Remotes")
local Action, State, Feedback = remotes:WaitForChild("Action"), remotes:WaitForChild("State"), remotes:WaitForChild("Feedback")
local C = {ink=Color3.fromRGB(19,23,27), panel=Color3.fromRGB(29,35,40), card=Color3.fromRGB(40,47,52), border=Color3.fromRGB(91,107,115), text=Color3.fromRGB(238,242,241), muted=Color3.fromRGB(162,178,181), cyan=Color3.fromRGB(163,218,197), gold=Color3.fromRGB(255,214,143), red=Color3.fromRGB(255,139,154), green=Color3.fromRGB(163,218,197), lilac=Color3.fromRGB(162,191,211), paper=Color3.fromRGB(238,242,241)}
-- Restore the rounded typography used by the original Tower release.
local regularFont = Font.fromEnum(Enum.Font.Nunito)
local strongFont = Font.fromEnum(Enum.Font.FredokaOne)
local SkillFX = remotes:WaitForChild("SkillFX")
local skillRequests = {Updraft=-100}
local shuttleCarry = {approvedUntil=-100}
local lastSkillApplied = {Updraft=-math.huge}
local skillBlockedBefore = -math.huge
local spectatorExitPending = false
local spectatorExitRequestAt = -100
local altitudeDots = {}
local snapshot = {phase="Waiting",coins=0,owned={ice=true},equipped="ice",progress=0,finishers={},racers={}}
local reducedMotion, muted, menuOpen = false, false, false
local menuPage = "Home"
local lastRestartAt = -100
local resetHold, resetFocused, resetPointer = ResetHold.New(), true, nil
local resetKeyInputs = {}
local lastFinished, lastCamera = nil, nil
local cinematic, spectateTarget = nil, nil
local introPlayed = false
local lastLevel = nil
local cameraKick, cameraOffsetApplied, toastSerial, menuSerial = 0, 0, 0, 0
